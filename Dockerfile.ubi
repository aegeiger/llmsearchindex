FROM registry.access.redhat.com/ubi9/python-312

# Switch to root for system package installs
USER 0

# Install system dependencies needed for faiss-cpu and other native extensions
RUN dnf install -y gcc gcc-c++ && dnf clean all

# Set working directory
WORKDIR /opt/app-root/src

# Copy requirements and install Python deps first (layer caching)
COPY pyproject.toml requirements.txt ./
COPY llmsearchindex/ ./llmsearchindex/

# Install the package and its dependencies
RUN pip install --no-cache-dir . && \
    pip install --no-cache-dir streamlit httpx pyarrow fsspec

# Copy remaining application code
COPY streamlit_app.py search.py ./

# Set HuggingFace cache to a writable location
ENV HF_HOME=/tmp/hf_cache

# Ensure writable dirs for OpenShift arbitrary UID
RUN mkdir -p /tmp/hf_cache && \
    chgrp -R 0 /opt/app-root /tmp/hf_cache && \
    chmod -R g=u /opt/app-root /tmp/hf_cache

# Switch to non-root user
USER 1001

# Expose Streamlit port
EXPOSE 8501

# Start Streamlit
CMD ["streamlit", "run", "streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
